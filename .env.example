# 값은 .env.local 또는 Vercel 환경변수에만 기재한다. 이 파일에는 키 이름만 둔다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
CRON_SECRET=
# 분석 설정 (ANALYSIS_ENABLED 는 명시적으로 true 여야 동작한다)
ANALYSIS_ENABLED=false
ANALYSIS_DAILY_LIMIT=3
ANALYSIS_MAX_INPUT_TOKENS=150000
ANALYSIS_EFFORT=medium
# 결제 (PAYMENTS_ENABLED 는 명시적으로 true 여야 동작한다. 테스트 키와 라이브 키는 환경별로 분리한다)
PAYMENTS_ENABLED=false
SIGNUP_FREE_CREDITS=0
